<?xml version="1.0" encoding="utf-8"?>
<!--
    Diseño para un elemento individual de la lista de recetas (item).
    Utiliza MaterialCardView para darle un aspecto de tarjeta con bordes redondeados y elevación.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.CardView.Filled"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    tools:theme="@style/Theme.Recetario">

    <!-- ConstraintLayout para posicionar los elementos internos de la tarjeta de forma eficiente -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Imagen miniatura de la receta -->
        <ImageView
            android:id="@+id/ivRecipe"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:background="?attr/colorSecondaryContainer"
            android:src="@android:drawable/ic_menu_gallery"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Título de la receta -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintStart_toEndOf="@+id/ivRecipe"
            app:layout_constraintTop_toTopOf="@+id/ivRecipe"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Breve descripción o resumen de la receta (limitado a 2 líneas) -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:ellipsize="end"
            android:maxLines="2"
            app:layout_constraintStart_toStartOf="@+id/tvTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Icono indicador (badge) que aparece si la receta tiene video -->
        <ImageView
            android:id="@+id/ivVideoBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:src="@android:drawable/ic_media_play"
            app:tint="?attr/colorPrimary"
            android:background="?attr/colorSecondaryContainer"
            android:padding="4dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/tvTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvDescription"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
